extends Node
## Tiny sound-effect player (autoload "Sfx"). Sounds live in assets/sfx and
## are generated by tools/make_sfx.py.

const NAMES := ["bell", "cash", "lose", "siren", "tick", "jackpot", "news", "flash",
	"coin", "liquidated", "swish", "whoosh", "click", "brrt", "heartbeat", "hum", "cough",
	"shot", "shot_big", "rack", "casing", "engine", "crash", "screech"]

var streams := {}
var _pool: Array = []
var volume_db := -4.0


func _ready() -> void:
	for n in NAMES:
		var s = load("res://assets/sfx/%s.wav" % n)
		if s:
			streams[n] = s
	for i in 10:
		var p := AudioStreamPlayer.new()
		add_child(p)
		_pool.append(p)


func play(sfx_name: String, db: float = 0.0, pitch: float = 1.0) -> void:
	if not streams.has(sfx_name):
		return
	for p in _pool:
		if not p.playing:
			p.stream = streams[sfx_name]
			p.volume_db = volume_db + db
			p.pitch_scale = pitch
			p.play()
			return


## A looping copy of a stream (for the 3D police siren).
func looped(sfx_name: String) -> AudioStream:
	if not streams.has(sfx_name):
		return null
	var s: AudioStreamWAV = streams[sfx_name].duplicate()
	s.loop_mode = AudioStreamWAV.LOOP_FORWARD
	s.loop_begin = 0
	s.loop_end = s.data.size() / 2
	return s


## Stop everything, give the audio thread a few frames to let go, then quit.
## (Quitting mid-sound makes Godot report leaked AudioStreamWAVs.)
func quit_game(code: int = 0) -> void:
	for p in _pool:
		p.stop()
		p.stream = null
	for c in get_tree().root.find_children("*", "AudioStreamPlayer3D", true, false):
		c.stop()
		c.stream = null
	streams.clear()
	Music.stop_all()
	await get_tree().create_timer(0.3).timeout
	get_tree().quit(code)
