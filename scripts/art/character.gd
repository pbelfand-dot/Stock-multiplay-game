static var _kit: PackedScene
static var _mats := {}

var look := {}
var pose := "idle"        # idle | aim | sit | type | type_stand | smoke | hold | dive | placard | cheer | cuffed
var move_speed := 0.0
var talking := false
var eyes_open := 0.82
## Red-veined eyes (stoned look). Set by looks ("bloodshot") or live by gameplay.
var bloodshot := false:
	set(v):
		if v != bloodshot:
			bloodshot = v
			_apply_eyes()

var j := {}               # attachment points: spine, head (aligned to character axes)
var prop_right: Node3D
var prop_left: Node3D
var skel: Skeleton3D
var _bi := {}             # bone name -> index
var _rest_q := {}         # idx -> local rest rotation
var _rest_b := {}         # idx -> global rest basis
var _rest_p := {}         # idx -> local rest position
var _state := {}          # our own per-bone Euler (never read back from the skeleton)
var _phase := 0.0
var _t := 0.0
var _blink := 0.0
var _next_blink := 2.0
var _pitch := 0.0


static func preset(name: String) -> Dictionary:
	return PRESETS.get(name, {})


static func player_look(index: int) -> Dictionary:
	return PLAYER_LOOKS[index % PLAYER_LOOKS.size()]


## Look with every key filled in (for the tailor menu / networking).
static func full_look(l: Dictionary) -> Dictionary:
	var out := DEFAULT.duplicate()
	for k in l:
		out[k] = l[k]
	return out


## Clean a look that came over the network: known keys, valid options only.
static func sanitize(l) -> Dictionary:
	var out := {}
	if not l is Dictionary:
		return out
	for k in l:
		if not DEFAULT.has(k):
			continue
		var v = l[k]
		if OPTIONS.has(k):
			if v is String and v in OPTIONS[k]:
				out[k] = v
		elif DEFAULT[k] is Color or k == "pants" or k == "brows":
			if v is Color:
				out[k] = Color(clampf(v.r, 0, 1), clampf(v.g, 0, 1), clampf(v.b, 0, 1))
		elif DEFAULT[k] is bool:
			if v is bool:
				out[k] = v
	return out


static func random_look(rng: RandomNumberGenerator = null) -> Dictionary:
	if rng == null:
		rng = RandomNumberGenerator.new()
		rng.randomize()
	var pick := func(arr: Array): return arr[rng.randi() % arr.size()]
	var l := {
		"outfit": pick.call(["suit", "suit", "suit", "shirt", "hoodie", "tee"]),
		"suit": pick.call(SUIT_COLORS), "pinstripe": rng.randf() < 0.6,
		"shirt": pick.call([Color(0.96, 0.96, 0.97), Color(0.96, 0.96, 0.97), Color(0.7, 0.8, 0.95), Color(0.95, 0.85, 0.9)]),
		"tie": pick.call(ACCENT_COLORS), "long_tie": rng.randf() < 0.2,
		"shoes": pick.call([Color(0.07, 0.07, 0.08), Color(0.35, 0.2, 0.1), Color(0.9, 0.9, 0.9)]),
		"shoe_style": pick.call(OPTIONS.shoe_style),
		"hair_style": pick.call(OPTIONS.hair_style), "hair": pick.call(HAIR_COLORS),
		"skin": pick.call(SKIN_TONES),
		"beard": pick.call(["none", "none", "mustache", "goatee", "full", "stubble"]),
		"glasses": pick.call(["none", "none", "shades", "specs"]),
		"hat": pick.call(["none", "none", "none", "headset", "beanie", "cap", "headband", "bowler", "bucket"]),
		"hat_color": pick.call(ACCENT_COLORS),
		"watch": pick.call(OPTIONS.watch), "chain": rng.randf() < 0.25,
	}
	return l


func _g(k: String):
	return look.get(k, DEFAULT.get(k))


# ------------------------------------------------------------------ materials

static func material(c: Color, kind: String = "cloth", stripes := false) -> StandardMaterial3D:
	var key := "%s_%s_%s" % [c.to_html(), kind, stripes]
	if _mats.has(key):
		return _mats[key]
	var m := StandardMaterial3D.new()
	m.albedo_color = c
	m.vertex_color_use_as_albedo = true
	m.roughness = 0.82
	m.metallic_specular = 0.3
	match kind:
		"skin":
			m.roughness = 0.7
			m.metallic_specular = 0.35
		"hair":
			m.roughness = 0.55
			m.metallic_specular = 0.45
		"metal":
			m.metallic = 0.85
			m.roughness = 0.3
		"fixed":
			m.albedo_color = Color.WHITE
			m.roughness = 0.5
	if stripes:
		# pinstripes: lighter vertical lines projected in model space
		var img := Image.create(32, 4, true, Image.FORMAT_RGB8)
		img.fill(c)
		for y in 4:
			img.set_pixel(0, y, c.lightened(0.22))
			img.set_pixel(1, y, c.lightened(0.1))
		img.generate_mipmaps()
		m.albedo_texture = ImageTexture.create_from_image(img)
		m.albedo_color = Color.WHITE
		m.uv1_triplanar = true
		m.uv1_triplanar_sharpness = 24.0   # no blended "rings": stripes stay straight
		m.uv1_scale = Vector3(1, 1, 1) * 26.0
		m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	_mats[key] = m
	return m


# ------------------------------------------------------------------ build

func build(l: Dictionary) -> void:
	look = l
	for c in get_children():
		remove_child(c)
		c.queue_free()
	j.clear()
	_bi.clear()
	_state.clear()
	if _kit == null:
		_kit = load(KIT_PATH)
	var inst: Node3D = _kit.instantiate()
	inst.name = "Kit"
	add_child(inst)
	scale = Vector3.ONE * SCALE
	skel = inst.find_children("*", "Skeleton3D", true, false)[0]
	for i in skel.get_bone_count():
		_bi[skel.get_bone_name(i)] = i
		_rest_q[i] = skel.get_bone_rest(i).basis.get_rotation_quaternion()
		_rest_p[i] = skel.get_bone_rest(i).origin
		_rest_b[i] = skel.get_bone_global_rest(i).basis.orthonormalized()
	var want := _wanted_pieces()
	for mi in inst.find_children("*", "MeshInstance3D", true, false):
		var nm: String = mi.name
		if not want.has(nm):
			if nm == "Acc_watch":   # kept (hidden) so a bought ROFLEX can appear live
				mi.visible = false
				continue
			mi.get_parent().remove_child(mi)
			mi.queue_free()
			continue
		mi.material_override = want[nm]
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
	# attachment points aligned with character axes (like the old joints)
	prop_right = _aligned_attachment("Hand_R", _bone_pos("Hand_R") + Vector3(-0.012, -0.075, -0.012), "GripR")
	prop_left = _aligned_attachment("Hand_L", _bone_pos("Hand_L") + Vector3(0.012, -0.075, -0.012), "GripL")
	j["spine"] = _aligned_attachment("Spine", Vector3(0, 0.93, 0), "SpineAnchor")
	j["head"] = _aligned_attachment("Head", _bone_pos("Head"), "HeadAnchor")
	bloodshot = bool(_g("bloodshot")) or bloodshot
	_apply_eyes()
	# POLICE lettering on the cap and the vest (front + back), Schedule I style
	if _g("hat") == "police":
		_print_on(j["head"], "POLICE", Vector3(0, 0.352, -0.238), Vector3(-0.39, PI, 0), Color(1.0, 0.85, 0.2), 0.0011)
	if _g("outfit") == "cop":
		_print_on(j["spine"], "POLICE", Vector3(0, 0.37, -0.154), Vector3(0, PI, 0), Color(0.97, 0.97, 0.97), 0.0028)
		_print_on(j["spine"], "POLICE", Vector3(0, 0.38, 0.165), Vector3.ZERO, Color(0.97, 0.97, 0.97), 0.0032)


func _print_on(anchor: Node3D, text: String, pos: Vector3, rot: Vector3, color: Color, px: float) -> void:
	var l := Label3D.new()
	l.text = text
	l.font_size = 48
	l.pixel_size = px
	l.modulate = color
	l.outline_size = 0
	l.position = pos
	l.rotation = rot
	l.double_sided = false
	var f = load("res://assets/fonts/Oswald-Bold.woff2")
	if f:
		l.font = f
	anchor.add_child(l)


## White eyeballs, or red-veined ones for the stoned look. Pupils stay black
## because the vertex colors multiply the texture.
static func _eye_material(veins: bool) -> StandardMaterial3D:
	var key := "eyes_%s" % veins
	if _mats.has(key):
		return _mats[key]
	var m := material(Color.WHITE, "fixed").duplicate()
	if veins:
		var n := 128
		var img := Image.create(n, n, true, Image.FORMAT_RGB8)
		img.fill(Color(0.98, 0.9, 0.88))
		var r := RandomNumberGenerator.new()
		r.seed = 99
		for i in 26:
			var p := Vector2(r.randf() * n, r.randf() * n)
			var dir := Vector2.from_angle(r.randf() * TAU)
			for step in 40:
				dir = dir.rotated(r.randf_range(-0.5, 0.5))
				p = (p + dir * 1.2).posmodv(Vector2(n, n))
				var c := Color(0.85, 0.12, 0.12).lerp(Color(0.98, 0.6, 0.6), step / 40.0)
				img.set_pixelv(Vector2i(p), c)
				img.set_pixelv(Vector2i((p + Vector2(1, 0)).posmodv(Vector2(n, n))), c)
		img.generate_mipmaps()
		m.albedo_texture = ImageTexture.create_from_image(img)
		m.uv1_triplanar = true
		m.uv1_scale = Vector3.ONE * 9.0
		m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	_mats[key] = m
	return m


static func watch_material(kind: String) -> StandardMaterial3D:
	match kind:
		"gold":
			return material(Color(1.0, 0.76, 0.25), "metal")
		"iced":   # diamonds: pale blue, glinting
			var key := "watch_iced"
			if not _mats.has(key):
				var m := material(Color(0.82, 0.92, 1.0), "metal").duplicate()
				m.emission_enabled = true
				m.emission = Color(0.55, 0.75, 1.0)
				m.emission_energy_multiplier = 0.6
				_mats[key] = m
			return _mats[key]
	return material(Color(0.75, 0.8, 0.88), "metal")


## Swap the wrist watch live (bought ROFLEX) without rebuilding the model.
func set_watch(kind: String) -> void:
	var mi := find_child("Acc_watch", true, false) as MeshInstance3D
	if mi == null:
		return
	mi.visible = kind != "none"
	if mi.visible:
		mi.material_override = watch_material(kind)


func _apply_eyes() -> void:
	if skel == null:
		return
	var eyes := find_child("Eyes", true, false) as MeshInstance3D
	if eyes:
		eyes.material_override = _eye_material(bloodshot)


func _bone_pos(bone: String) -> Vector3:
	return skel.get_bone_global_rest(_bi[bone]).origin


func _aligned_attachment(bone: String, pos: Vector3, node_name: String) -> Node3D:
	var ba := BoneAttachment3D.new()
	ba.bone_name = bone
	skel.add_child(ba)
	var n := Node3D.new()
	n.name = node_name
	var rest := skel.get_bone_global_rest(_bi[bone])
	n.transform = rest.affine_inverse() * Transform3D(Basis.IDENTITY, pos)
	ba.add_child(n)
	return n


## Which kit meshes this look wears, with their materials.
func _wanted_pieces() -> Dictionary:
	var skin: Color = _g("skin")
	var hair: Color = _g("hair")
	var top: Color = _g("suit")
	var pants: Color = _g("pants") if _g("pants") != null else top.darkened(0.04)
	var outfit: String = _g("outfit")
	var stripes: bool = _g("pinstripe") and outfit == "suit"
	var skin_m := material(skin, "skin")
	var hair_m := material(hair, "hair")
	var fixed_m := material(Color.WHITE, "fixed")
	var w := {
		"Body": skin_m, "Skull": skin_m, "Lids": skin_m, "Hands": skin_m,
		"Eyes": _eye_material(bool(_g("bloodshot"))), "Mouth": fixed_m,
		"Brows": material(_g("brows") if _g("brows") != null else hair.darkened(0.15), "hair"),
		"Pants": material(pants, "cloth", stripes),
	}
	var shoe: String = _g("shoe_style")
	w["Shoes_" + shoe] = material(_g("shoes"), "cloth")
	if shoe == "sneaker":
		w["Soles_sneaker"] = fixed_m
	var top_m := material(top, "cloth", stripes)
	var tie_piece := "Tie_long" if _g("long_tie") else "Tie"
	match outfit:
		"suit":
			w["Jacket"] = top_m
			w["Shirt_v"] = material(_g("shirt"), "cloth")
			w["Shirt_cuffs"] = material(_g("shirt"), "cloth")
			w[tie_piece] = material(_g("tie"), "cloth")
		"shirt":
			w["Top_shirt"] = top_m
			w[tie_piece] = material(_g("tie"), "cloth")
		"cop":
			w["Top_cop"] = top_m
			w["Gear_cop"] = fixed_m
			w["Vest_cop"] = fixed_m
		"hoodie":
			w["Top_hoodie"] = top_m
		"tee":
			w["Top_tee"] = top_m
	var hs: String = _g("hair_style")
	# hats squash big hair: swap in a short cut underneath
	if _g("hat") in ["beanie", "cap", "cop", "police", "bowler", "bucket"] and hs in ["afro", "messy", "swoop", "slick", "swept", "long"]:
		hs = "short"
	if hs != "none":
		w["Hair_" + hs] = hair_m
	var beard: String = _g("beard")
	if beard == "stubble":
		w["Beard_stubble"] = material(skin.lerp(hair.darkened(0.4), 0.3), "skin")
	elif beard != "none":
		w["Beard_" + beard] = hair_m
	if _g("glasses") != "none":
		w["Glasses_" + _g("glasses")] = fixed_m
	var hat: String = _g("hat")
	if hat in ["cop", "headset", "police"]:
		w["Hat_" + hat] = fixed_m
	elif hat != "none":
		w["Hat_" + hat] = material(_g("hat_color"), "cloth")
	var watch: String = _g("watch")
	if watch != "none":
		w["Acc_watch"] = watch_material(watch)
	var gold := material(Color(1.0, 0.76, 0.25), "metal")
	if _g("ring"):
		w["Acc_ring"] = gold
	if _g("chain") and outfit != "cop":   # each outfit has its own chain that lies flush on it
		w["Acc_chain_" + outfit] = gold
	return w


# ------------------------------------------------------------------ animation

func _pose_bone(bone: String, euler: Vector3, k: float) -> void:
	var i: int = _bi.get(bone, -1)
	if i < 0:
		return
	var cur: Vector3 = _state.get(i, Vector3.ZERO)
	cur = cur.lerp(euler, k)
	_state[i] = cur
	# character-space rotation → bone-local delta (conjugate by the bone's global rest)
	var q := Basis.from_euler(cur)
	var b: Basis = _rest_b[i]
	var delta := b.inverse() * q * b
	skel.set_bone_pose_rotation(i, _rest_q[i] * delta.get_rotation_quaternion())


func _process(delta: float) -> void:
	if skel == null:
		return
	_t += delta
	var sp := clampf(move_speed, 0.0, 9.0)
	_phase += delta * (4.0 + sp * 1.25) * (1.0 if sp > 0.2 else 0.0)
	var walk := clampf(sp / 4.5, 0.0, 1.6)
	var s := sin(_phase)
	var c := cos(_phase)
	var breathe := sin(_t * 2.0) * 0.012
	var idle := 1.0 - clampf(walk * 2.0, 0.0, 1.0)
	var shift := sin(_t * 0.7) * idle          # idle weight shift from foot to foot
	var run := clampf(walk - 1.0, 0.0, 0.6)
	var t := {
		"root_y": 0.0, "root_rx": 0.0, "spine_rx": -0.02 + breathe - walk * 0.05 - run * 0.25, "chest_rx": breathe * 0.6,
		# hips twist with the stride, shoulders counter-twist; a little side roll
		"hips_ry": s * 0.14 * walk, "hips_rz": c * 0.05 * walk + shift * 0.035, "spine_ry": -s * 0.18 * walk,
		"shL": Vector3(s * 0.55 * walk, 0, -0.05 - shift * 0.02), "shR": Vector3(-s * 0.55 * walk, 0, 0.05 - shift * 0.02),
		# elbows bend more on the back-swing, runners pump bent arms
		"elL": Vector3(0.12 + (0.2 + maxf(0.0, -s) * 0.35) * walk + run * 0.9, 0, 0),
		"elR": Vector3(0.12 + (0.2 + maxf(0.0, s) * 0.35) * walk + run * 0.9, 0, 0),
		"hipL": Vector3(-s * 0.62 * walk + shift * 0.03, 0, 0.02 * shift), "hipR": Vector3(s * 0.62 * walk - shift * 0.03, 0, 0.02 * shift),
		"knL": Vector3(-maxf(0.0, c) * 1.05 * walk - maxf(0.0, shift) * 0.08, 0, 0),
		"knR": Vector3(-maxf(0.0, -c) * 1.05 * walk - maxf(0.0, -shift) * 0.08, 0, 0),
		"ftL": Vector3(maxf(0.0, c) * 0.35 * walk, 0, 0), "ftR": Vector3(maxf(0.0, -c) * 0.35 * walk, 0, 0),
		"bob": absf(s) * 0.035 * walk - 0.01 * walk, "hand": Vector3.ZERO, "head_rx": 0.0, "head_ry": 0.0,
	}
	var upper: String = pose.trim_prefix("sit_") if pose.begins_with("sit_") else pose
	if pose.begins_with("sit"):
		t.root_y = -0.43
		t.hipL = Vector3(1.5, 0, 0.12)
		t.hipR = Vector3(1.5, 0, -0.12)
		t.knL = Vector3(-1.45, 0, 0)
		t.knR = Vector3(-1.45, 0, 0)
		t.ftL = Vector3(0.1, 0, 0)
		t.ftR = Vector3(0.1, 0, 0)
		t.spine_rx = -0.12
		t.bob = 0.0
		t.hips_rz = 0.0
		t.hips_ry = 0.0
		t.spine_ry = 0.0
		t.shL = Vector3(0.35, 0, -0.1)
		t.shR = Vector3(0.35, 0, 0.1)
		t.elL = Vector3(0.9, 0, 0)
		t.elR = Vector3(0.9, 0, 0)
	match upper:
		"finger":   # the bird, right in their face
			t.shR = Vector3(1.25, 0.25, 0.1)
			t.elR = Vector3(1.55, 0, 0)
			t.head_rx = -0.05
		"fistpump":
			var pump := absf(sin(_t * 9.0))
			t.shR = Vector3(2.3 + pump * 0.4, 0.1, 0.2)
			t.elR = Vector3(1.2 - pump * 0.9, 0, 0)
			t.shL = Vector3(0.3, 0, -0.1)
			t.spine_rx -= 0.1
		"watch":    # left forearm across the chest, wrist turned up, admire it
			t.shL = Vector3(1.05, -0.55, 0.15)
			t.elL = Vector3(1.35, 0, 0)
			t.shR = Vector3(0.25, 0.1, 0.05)
			t.head_rx = 0.45
			t.head_ry = 0.3
		"point":
			t.shR = Vector3(1.5, 0.05, 0.05)
			t.elR = Vector3(0.05, 0, 0)
		"dunk":
			t.shL = Vector3(2.9, -0.15, 0)
			t.shR = Vector3(2.9, 0.15, 0)
			t.elL = Vector3(0.3, 0, 0)
			t.elR = Vector3(0.3, 0, 0)
			t.knL = Vector3(-1.0, 0, 0)
			t.knR = Vector3(-0.6, 0, 0)
			t.hipL = Vector3(0.6, 0, 0)
			t.spine_rx = -0.15
		"aim":
			t.shL = Vector3(1.42, -0.42, 0)
			t.shR = Vector3(1.42, 0.42, 0)
			t.elL = Vector3(0.12, 0, 0)
			t.elR = Vector3(0.12, 0, 0)
			t.spine_rx = 0.03
		"type":
			t.root_y = -0.43
			t.hipL = Vector3(1.5, 0, 0.05)
			t.hipR = Vector3(1.5, 0, -0.05)
			t.knL = Vector3(-1.5, 0, 0)
			t.knR = Vector3(-1.5, 0, 0)
			t.shL = Vector3(0.9, -0.2, 0)
			t.shR = Vector3(0.9, 0.2, 0)
			t.elL = Vector3(0.9 + sin(_t * 18.0) * 0.08, 0, 0)
			t.elR = Vector3(0.9 + cos(_t * 17.0) * 0.08, 0, 0)
		"type_stand":
			t.shL = Vector3(0.75, -0.2, 0)
			t.shR = Vector3(0.75, 0.2, 0)
			t.elL = Vector3(0.8 + sin(_t * 18.0) * 0.08, 0, 0)
			t.elR = Vector3(0.8 + cos(_t * 17.0) * 0.08, 0, 0)
			t.spine_rx = 0.12
		"smoke":
			var puff := (sin(_t * 0.9) + 1.0) * 0.5
			t.shR = Vector3(0.5 + puff * 0.3, 0.5, 0.1)
			t.elR = Vector3(2.0 + puff * 0.3, 0, 0)
		"hold":
			t.shR = Vector3(1.3, -0.05, 0.1)
			t.elR = Vector3(0.2, 0, 0)
		"cheer":
			t.shL = Vector3(0.8, -0.3, -0.15)
			t.shR = Vector3(0.8, 0.3, 0.15)
			t.elL = Vector3(1.4 + sin(_t * 6.0) * 0.3, 0, 0)
			t.elR = Vector3(1.4 - sin(_t * 6.0) * 0.3, 0, 0)
		"placard":
			t.shL = Vector3(0.7, -0.45, 0)
			t.shR = Vector3(0.7, 0.45, 0)
			t.elL = Vector3(0.8, 0, 0)
			t.elR = Vector3(0.8, 0, 0)
		"cuffed":
			t.shL = Vector3(-0.35, 0, -0.2)
			t.shR = Vector3(-0.35, 0, 0.2)
			t.elL = Vector3(0.9, 0, 0)
			t.elR = Vector3(0.9, 0, 0)
		"dive":
			t.root_rx = -1.25
			t.root_y = -0.55
			t.shL = Vector3(2.8, -0.15, 0)
			t.shR = Vector3(2.8, 0.15, 0)
			t.elL = Vector3(0.1, 0, 0)
			t.elR = Vector3(0.1, 0, 0)
			t.hipL = Vector3(-0.2, 0, 0)
			t.hipR = Vector3(-0.35, 0, 0)
			t.knL = Vector3(-0.5, 0, 0)
			t.knR = Vector3(-0.3, 0, 0)
	# the kit is rigged in an A-pose (arms 20 deg out): bring the arms in
	t.shL = t.shL + Vector3(0, 0, ARM_IN)
	t.shR = t.shR - Vector3(0, 0, ARM_IN)
	var k := clampf(delta * 12.0, 0.0, 1.0)
	var hips: int = _bi["Hips"]
	var ry: float = _state.get("root_y", 0.0)
	ry = lerpf(ry, t.root_y + t.bob, k)
	_state["root_y"] = ry
	skel.set_bone_pose_position(hips, _rest_p[hips] + Vector3(0, ry, 0))
	_pose_bone("Hips", Vector3(t.root_rx, t.hips_ry, t.hips_rz), k)
	_pose_bone("Spine", Vector3(t.spine_rx, t.spine_ry, -t.hips_rz * 0.6), k)
	_pose_bone("Chest", Vector3(t.chest_rx, 0, 0), k)
	_pose_bone("UpperArm_L", t.shL, k)
	_pose_bone("UpperArm_R", t.shR, k)
	_pose_bone("Forearm_L", t.elL, k)
	_pose_bone("Forearm_R", t.elR, k)
	_pose_bone("Thigh_L", t.hipL, k)
	_pose_bone("Thigh_R", t.hipR, k)
	_pose_bone("Shin_L", t.knL, k)
	_pose_bone("Shin_R", t.knR, k)
	_pose_bone("Foot_L", t.ftL, k)
	_pose_bone("Foot_R", t.ftR, k)
	_pose_bone("Neck", Vector3(_pitch * 0.5, 0, 0), k)
	_pose_bone("Head", Vector3(_pitch * 0.3 + t.head_rx, sin(_t * 0.37) * 0.08 * idle + t.head_ry - t.spine_ry * 0.5, 0), k)
	# blink + tired lids
	_next_blink -= delta
	if _next_blink <= 0.0:
		_blink = 0.13
		_next_blink = randf_range(2.0, 5.0)
	_blink = maxf(_blink - delta, 0.0)
	var open := 0.0 if _blink > 0.0 else eyes_open
	var lid_rot := lerpf(-1.45, 0.25, open)
	_pose_bone("Lid_L", Vector3(lid_rot, 0, 0), clampf(delta * 25.0, 0, 1))
	_pose_bone("Lid_R", Vector3(lid_rot, 0, 0), clampf(delta * 25.0, 0, 1))
	# talking: stretch the mouth on the jaw bone
	var jaw: int = _bi.get("Jaw", -1)
	if jaw >= 0:
		var m_open := (0.5 + 0.5 * sin(_t * 14.0)) * 3.2 + 1.0 if talking else 1.0
		var cur: float = _state.get("jaw", 1.0)
		cur = lerpf(cur, m_open, clampf(delta * 20.0, 0, 1))
		_state["jaw"] = cur
		skel.set_bone_pose_scale(jaw, Vector3(0.85 if talking else 1.0, cur, 1.0))


func look_pitch(p: float) -> void:
	_pitch = clampf(p, -0.6, 0.6)
