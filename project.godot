; Engine configuration file.
; Godot 4.7 project — BAGHOLDERS

config_version=5

[application]

config/name="BAGHOLDERS"
config/description="Co-op / PvP first-person trading floor chaos. Everyone shares the bag."
run/main_scene="res://scenes/main.tscn"
config/icon="res://icon.png"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Config="*res://scripts/net/config.gd"
Graphics="*res://scripts/net/graphics.gd"
Net="*res://scripts/net/net.gd"
Sfx="*res://scripts/net/sfx.gd"
Music="*res://scripts/net/music.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
textures/vram_compression/import_etc2_astc=true
